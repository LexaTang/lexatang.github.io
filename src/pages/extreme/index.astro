---
import Layout from '../../layouts/Layout.astro';
import PerfMonitor from '../../components/PerfMonitor.tsx';
import fs from 'node:fs';
import path from 'node:path';

const emojiDir = path.resolve('public/EmojiMockPacks');
const dirs = fs.readdirSync(emojiDir).filter((d: string) => {
  return fs.statSync(path.join(emojiDir, d)).isDirectory();
}).sort((a: string, b: string) => Number(a) - Number(b));

const items = dirs.map((d: string) => ({
  id: d,
  basePath: `/EmojiMockPacks/${d}/${d}`,
}));
---

<Layout title="Extreme Mode - Emoji Viewer" activeTab="extreme">
  <div class="extreme-toolbar">
    <div class="toolbar-left">
      <span id="status-info" class="status-info">0 / 0 images</span>
      <span id="status-warn" class="status-warn"></span>
    </div>
    <div class="toolbar-right">
      <div class="format-switcher">
        <button class="fmt-btn fmt-btn--active" data-format="gif">GIF</button>
      </div>
      <div class="count-control">
        <label for="count-input">Count:</label>
        <input type="range" id="count-range" min="50" max="1615" step="50" value="1000" />
        <input type="number" id="count-input" min="1" max="1615" value="1000" />
      </div>
      <button class="fmt-btn" id="btn-lazy" title="loading attribute">LOAD:OFF</button>
      <button class="fmt-btn" id="btn-decode" title="decoding attribute">DEC:OFF</button>
      <button class="fmt-btn" id="btn-cv" title="content-visibility">CV:OFF</button>
      <div class="col-control">
        <label for="col-range">Cols:</label>
        <input type="range" id="col-range" min="5" max="50" step="1" value="20" />
        <span id="col-value">20</span>
      </div>
      <button class="fmt-btn fmt-btn--danger" id="btn-go">GO!</button>
    </div>
  </div>

  <div id="grid-container" class="extreme-grid-container">
    <div id="emoji-grid" class="extreme-grid"></div>
  </div>

  <!-- Preview overlay -->
  <div id="preview-overlay" class="preview-overlay" style="display:none;">
    <div class="preview-content">
      <img id="preview-img" src="" alt="preview" />
      <button class="preview-close" id="preview-close">&times;</button>
    </div>
  </div>

  <PerfMonitor client:load />
</Layout>

<script define:vars={{ items }}>
  window.__EMOJI_ITEMS__ = items;
</script>

<script>
  const allItems = (window as any).__EMOJI_ITEMS__ as Array<{ id: string; basePath: string }>;

  // --- Tri-state definitions ---
  const LOADING_STATES: (string | null)[] = [null, 'lazy', 'eager'];
  const DECODING_STATES: (string | null)[] = [null, 'sync', 'async'];
  const CV_STATES: (string | null)[] = [null, 'auto', 'hidden'];

  // --- URL helpers ---
  function getUrlParams() {
    return new URLSearchParams(window.location.search);
  }

  function idxOf(states: (string | null)[], val: string | null): number {
    if (val === null || val === 'off') return 0;
    const i = states.indexOf(val);
    return i >= 0 ? i : 0;
  }

  function initState() {
    const p = getUrlParams();
    return {
      fmt: p.get('fmt') || 'gif',
      count: Math.min(allItems.length, Math.max(1, parseInt(p.get('count') || '1000', 10) || 1000)),
      cols: Math.max(5, Math.min(50, parseInt(p.get('cols') || '20', 10) || 20)),
      loadIdx: idxOf(LOADING_STATES, p.get('load')),
      decIdx: idxOf(DECODING_STATES, p.get('dec')),
      cvIdx: idxOf(CV_STATES, p.get('cv')),
      started: p.get('go') === '1',
    };
  }

  const init = initState();

  // --- State ---
  let currentFormat = init.fmt;
  let imgCount = init.count;
  let columns = init.cols;
  let loadingIdx = init.loadIdx;
  let decodingIdx = init.decIdx;
  let cvIdx = init.cvIdx;

  function syncUrl() {
    const p = new URLSearchParams();
    if (currentFormat !== 'gif') p.set('fmt', currentFormat);
    if (imgCount !== 1000) p.set('count', String(imgCount));
    if (columns !== 20) p.set('cols', String(columns));
    const ld = LOADING_STATES[loadingIdx];
    if (ld) p.set('load', ld); else if (getUrlParams().has('load')) p.set('load', 'off');
    const dc = DECODING_STATES[decodingIdx];
    if (dc) p.set('dec', dc); else if (getUrlParams().has('dec')) p.set('dec', 'off');
    const cv = CV_STATES[cvIdx];
    if (cv) p.set('cv', cv); else if (getUrlParams().has('cv')) p.set('cv', 'off');
    const qs = p.toString();
    const newUrl = qs ? `${window.location.pathname}?${qs}` : window.location.pathname;
    window.history.replaceState(null, '', newUrl);
  }

  // --- DOM refs ---
  const grid = document.getElementById('emoji-grid')!;
  const gridContainer = document.getElementById('grid-container')!;
  const statusInfo = document.getElementById('status-info')!;
  const statusWarn = document.getElementById('status-warn')!;
  const countRange = document.getElementById('count-range') as HTMLInputElement;
  const countInput = document.getElementById('count-input') as HTMLInputElement;
  const colRange = document.getElementById('col-range') as HTMLInputElement;
  const colValue = document.getElementById('col-value')!;
  const btnGo = document.getElementById('btn-go')!;
  const btnLazy = document.getElementById('btn-lazy')!;
  const btnDecode = document.getElementById('btn-decode')!;
  const btnCv = document.getElementById('btn-cv')!;
  const previewOverlay = document.getElementById('preview-overlay')!;
  const previewImg = document.getElementById('preview-img') as HTMLImageElement;
  const previewClose = document.getElementById('preview-close')!;
  const formatBtns = document.querySelectorAll<HTMLButtonElement>('[data-format]');

  const PLACEHOLDER = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
  let imgCells: HTMLDivElement[] = [];
  let imgElements: HTMLImageElement[] = [];
  let rendered = false;

  // Init input values from state
  countRange.value = String(imgCount);
  countInput.value = String(imgCount);
  colRange.value = String(columns);
  colValue.textContent = String(columns);

  function getSrc(item: { id: string; basePath: string }): string {
    return `${item.basePath}.${currentFormat}`;
  }

  function updateBtnLabel(btn: HTMLElement, prefix: string, states: (string | null)[], idx: number) {
    const val = states[idx];
    btn.textContent = val ? `${prefix}:${val.toUpperCase()}` : `${prefix}:OFF`;
    btn.classList.toggle('fmt-btn--active', val !== null);
  }

  function clearGrid() {
    grid.innerHTML = '';
    imgCells = [];
    imgElements = [];
    rendered = false;
    statusInfo.textContent = `0 / ${allItems.length} images`;
    statusWarn.textContent = '';
  }

  function buildExtremeGrid() {
    const startTime = performance.now();
    clearGrid();

    const count = Math.min(imgCount, allItems.length);
    grid.style.gridTemplateColumns = `repeat(${columns}, 1fr)`;

    const ld = LOADING_STATES[loadingIdx];
    const dc = DECODING_STATES[decodingIdx];
    const cv = CV_STATES[cvIdx];

    const fragment = document.createDocumentFragment();

    for (let i = 0; i < count; i++) {
      const item = allItems[i];
      const cell = document.createElement('div');
      cell.className = 'emoji-cell';

      if (cv) {
        cell.style.contentVisibility = cv;
        cell.style.containIntrinsicSize = '0 auto';
      }

      const img = document.createElement('img');
      img.src = getSrc(item);
      img.alt = item.id;
      if (ld) img.loading = ld as any;
      if (dc) img.decoding = dc as any;

      cell.appendChild(img);
      cell.addEventListener('click', () => {
        previewImg.src = img.src;
        previewOverlay.style.display = 'flex';
      });

      fragment.appendChild(cell);
      imgCells.push(cell);
      imgElements.push(img);
    }

    grid.appendChild(fragment);
    rendered = true;

    const elapsed = (performance.now() - startTime).toFixed(1);
    statusInfo.textContent = `${count} / ${allItems.length} images`;
    statusWarn.textContent = `Built in ${elapsed}ms`;

    syncUrl();
  }

  function applyImgAttrs() {
    const ld = LOADING_STATES[loadingIdx];
    const dc = DECODING_STATES[decodingIdx];
    for (const img of imgElements) {
      if (ld) { img.loading = ld as any; } else { img.removeAttribute('loading'); }
      if (dc) { img.decoding = dc as any; } else { img.removeAttribute('decoding'); }
    }
  }

  function applyCv() {
    const cv = CV_STATES[cvIdx];
    for (const cell of imgCells) {
      if (cv) {
        cell.style.contentVisibility = cv;
        cell.style.containIntrinsicSize = '0 auto';
      } else {
        cell.style.contentVisibility = '';
        cell.style.containIntrinsicSize = '';
      }
    }
  }

  // --- Event bindings ---

  countRange.addEventListener('input', () => {
    imgCount = parseInt(countRange.value, 10);
    countInput.value = countRange.value;
  });

  countInput.addEventListener('change', () => {
    let v = parseInt(countInput.value, 10) || 1000;
    v = Math.max(1, Math.min(allItems.length, v));
    imgCount = v;
    countInput.value = String(v);
    countRange.value = String(v);
  });

  colRange.addEventListener('input', () => {
    columns = parseInt(colRange.value, 10);
    colValue.textContent = colRange.value;
    if (rendered) {
      grid.style.gridTemplateColumns = `repeat(${columns}, 1fr)`;
      syncUrl();
    }
  });

  btnGo.addEventListener('click', () => {
    buildExtremeGrid();
  });

  btnLazy.addEventListener('click', () => {
    loadingIdx = (loadingIdx + 1) % LOADING_STATES.length;
    updateBtnLabel(btnLazy, 'LOAD', LOADING_STATES, loadingIdx);
    if (rendered) applyImgAttrs();
    syncUrl();
  });

  btnDecode.addEventListener('click', () => {
    decodingIdx = (decodingIdx + 1) % DECODING_STATES.length;
    updateBtnLabel(btnDecode, 'DEC', DECODING_STATES, decodingIdx);
    if (rendered) applyImgAttrs();
    syncUrl();
  });

  btnCv.addEventListener('click', () => {
    cvIdx = (cvIdx + 1) % CV_STATES.length;
    updateBtnLabel(btnCv, 'CV', CV_STATES, cvIdx);
    if (rendered) applyCv();
    syncUrl();
  });

  formatBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      currentFormat = btn.dataset.format!;
      formatBtns.forEach((b) => b.classList.toggle('fmt-btn--active', b.dataset.format === currentFormat));
      if (rendered) {
        for (let i = 0; i < imgElements.length; i++) {
          imgElements[i].src = getSrc(allItems[i]);
        }
      }
      syncUrl();
    });
  });

  previewOverlay.addEventListener('click', () => { previewOverlay.style.display = 'none'; });
  previewClose.addEventListener('click', () => { previewOverlay.style.display = 'none'; });
  previewOverlay.querySelector('.preview-content')?.addEventListener('click', (e) => { e.stopPropagation(); });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') previewOverlay.style.display = 'none';
  });

  // --- Init ---
  formatBtns.forEach((btn) => {
    btn.classList.toggle('fmt-btn--active', btn.dataset.format === currentFormat);
  });
  updateBtnLabel(btnLazy, 'LOAD', LOADING_STATES, loadingIdx);
  updateBtnLabel(btnDecode, 'DEC', DECODING_STATES, decodingIdx);
  updateBtnLabel(btnCv, 'CV', CV_STATES, cvIdx);
  statusInfo.textContent = `0 / ${allItems.length} images (press GO!)`;

  // Auto-start if URL has go=1
  if (init.started) {
    buildExtremeGrid();
  }
</script>

<style>
  .extreme-toolbar {
    padding: 8px 0 12px;
    font-size: 0.85rem;
    color: #666;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
  }

  .toolbar-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .toolbar-right {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .status-info {
    color: #aaa;
    font-variant-numeric: tabular-nums;
  }

  .status-warn {
    color: #facc15;
    font-size: 0.8rem;
  }

  .format-switcher {
    display: flex;
    gap: 4px;
  }

  .count-control,
  .col-control {
    display: flex;
    align-items: center;
    gap: 6px;
    color: #888;
    font-size: 0.75rem;
  }

  .count-control label,
  .col-control label {
    font-weight: 600;
    letter-spacing: 0.5px;
  }

  .count-control input[type="range"],
  .col-control input[type="range"] {
    width: 80px;
    accent-color: #667eea;
  }

  .count-control input[type="number"] {
    width: 60px;
    padding: 2px 4px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.05);
    color: #ccc;
    font-size: 0.75rem;
    font-family: monospace;
    text-align: center;
  }

  #col-value {
    min-width: 20px;
    text-align: center;
    font-family: monospace;
    color: #ccc;
  }

  .fmt-btn {
    padding: 3px 10px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.05);
    color: #999;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    letter-spacing: 0.5px;
  }

  .fmt-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #ccc;
  }

  .fmt-btn--active {
    background: #667eea;
    border-color: #667eea;
    color: #fff;
  }

  .fmt-btn--active:hover {
    background: #5a6fd6;
  }

  .fmt-btn--danger {
    background: #dc2626;
    border-color: #dc2626;
    color: #fff;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 3px 16px;
  }

  .fmt-btn--danger:hover {
    background: #ef4444;
    border-color: #ef4444;
  }

  .extreme-grid-container {
    height: calc(100vh - 160px);
    overflow: auto;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .extreme-grid {
    display: grid;
    gap: 2px;
    padding: 2px;
  }

  .extreme-grid :global(.emoji-cell) {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1;
    background: rgba(255, 255, 255, 0.02);
    border-radius: 4px;
    cursor: pointer;
    overflow: hidden;
  }

  .extreme-grid :global(.emoji-cell:hover) {
    background: rgba(255, 255, 255, 0.08);
  }

  .extreme-grid :global(.emoji-cell img) {
    max-width: 90%;
    max-height: 90%;
    object-fit: contain;
  }

  .preview-overlay {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    animation: fadeIn 0.2s ease;
  }

  .preview-content {
    position: relative;
    max-width: 90vw;
    max-height: 90vh;
  }

  .preview-content img {
    max-width: 400px;
    max-height: 400px;
    border-radius: 12px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
  }

  .preview-close {
    position: absolute;
    top: -12px;
    right: -12px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: none;
    background: #333;
    color: #fff;
    font-size: 1.2rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
  }

  .preview-close:hover {
    background: #555;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
</style>
